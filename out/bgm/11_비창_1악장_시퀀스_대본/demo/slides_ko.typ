#let beat(self, j, meta, ts, cue, body, subs: ()) = {
  let cur = self.subslide == j
  let col = if cur { accent } else if self.subslide > j { past } else { ink }
  if cur {
    context [#metadata((page: here().page(), ..meta)) <sync-beat>]
    for s in subs { context [#metadata((page: here().page(), ..s)) <sync-beat>] }
  }
  block(width: 100%, above: 0.55em, below: 0.55em, inset: (left: 0.5em),
    stroke: (left: if cur { 2.5pt + accent } else { 2.5pt + white }),
    text(fill: col)[#text(weight: "bold")[#ts]#if cue != none [ #cue] #body])
}
