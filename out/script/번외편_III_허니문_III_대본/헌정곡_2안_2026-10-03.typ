  columns: (auto, 1fr, auto),
  table.header([], [가사], [음절]),
  [A], [오 해송아, 오 해송아], [8],
  [], [내 곁에 있어 줄래], [7],
  [B], [남은 봄과 남은 겨울], [8],
  [], [남은 날을 전부 나와], [8],
  [A], [오 해송아, 오 해송아], [8],
  [], [내 곁에 있어 줄래], [7],
