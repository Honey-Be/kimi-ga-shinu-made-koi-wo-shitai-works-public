#let era_label = (
  "親": "両親の時代",
  "娘": "娘の時代",
  "承諾": "承諾した人の時代",
  "終戦": "終戦",
  "以後": "終戦後",
)

#figure(
  canvas(length: 1cm, {
    import draw: *
    let row-h = 0.52
    let top = 0.0
    let x-spine = 4.6
    let x-year-r = 4.3
    let x-text-l = 5.0
    let x-text-w = 13.2
    let gap = 0.38

    let total-h = 0.0
    let prev-era0 = none
    for ev in events {
      if ev.at(2) != prev-era0 { total-h += gap }
      total-h += row-h
      prev-era0 = ev.at(2)
    }
    line((x-spine, top + 0.3), (x-spine, top - total-h + row-h - 0.1), stroke: (paint: gray, thickness: 1pt))

    let y = top
    let prev-era = none
    for ev in events {
      let (yr, desc, era) = ev
      if era != prev-era {
        if prev-era != none { y -= gap }
        content((x-text-l, y + row-h * 0.95), text(size: 8.5pt, fill: gray.darken(35%), weight: "bold")[#era_label.at(era)])
        prev-era = era
      }
      let is-zero = era == "終戦"
      circle((x-spine, y), radius: if is-zero { 0.09 } else { 0.045 }, fill: if is-zero { black } else { gray.darken(10%) }, stroke: none)
      content((x-year-r, y), anchor: "east",
        text(size: 8pt, weight: if is-zero { "bold" } else { "regular" })[#yr])
      content((x-text-l, y), anchor: "west",
        box(width: x-text-w * 1cm, text(size: 7.6pt, weight: if is-zero { "bold" } else { "regular" })[#desc]))
      y -= row-h
    }
  }),
  caption: [タイムライン ―― 終戦(0年4月7日)を基準にした相対年表。*間隔は事象の順序を示すのみで年数に比例しない* ―― 各項目の年次表記だけが正確である。`proposals/P37` 確定案(`P49`・`P50`で修正)。原典 v2.4 amend ―― ハインリヒが捕まった日と死んだ日を−1年から−8か月・−7か月前後へ移した(彼はフランの妊娠を生前に知っていた ―― 第19.5話；受胎は終戦の9か月前前後)、発掘も併せて。],
  supplement: none,
  numbering: none,
)
