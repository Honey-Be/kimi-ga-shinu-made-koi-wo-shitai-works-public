#let era_label = (
  "부모": "부모의 시대",
  "딸": "딸의 시대",
  "승낙": "승낙한 사람의 시대",
  "종전": "종전",
  "이후": "종전 이후",
)

#figure(
  canvas(length: 1cm, {
    import draw: *
    let row-h = 0.52
    let n = events.len()
    let top = 0.0
    let x-spine = 4.6
    let x-year-r = 4.3
    let x-text-l = 5.0
    let x-text-w = 13.2

    let gap = 0.38
    // 전체 높이를 먼저 계산(에라 전환마다 gap 추가)
    let total-h = 0.0
    let prev-era0 = none
    for ev in events {
      if ev.at(2) != prev-era0 { total-h += gap }
      total-h += row-h
      prev-era0 = ev.at(2)
    }
    line((x-spine, top + 0.3), (x-spine, top - total-h + row-h - 0.1), stroke: (paint: gray, thickness: 1pt))

    let y = top
    let prev-era = none
    for ev in events {
      let (yr, desc, era) = ev
      if era != prev-era {
        if prev-era != none { y -= gap }
        content((x-text-l, y + row-h * 0.95), text(size: 8.5pt, fill: gray.darken(35%), weight: "bold")[#era_label.at(era)])
        prev-era = era
      }
      let is-zero = era == "종전"
      circle((x-spine, y), radius: if is-zero { 0.09 } else { 0.045 }, fill: if is-zero { black } else { gray.darken(10%) }, stroke: none)
      content((x-year-r, y), anchor: "east",
        text(size: 8pt, weight: if is-zero { "bold" } else { "regular" })[#yr])
      content((x-text-l, y), anchor: "west",
        box(width: x-text-w * 1cm, text(size: 7.6pt, weight: if is-zero { "bold" } else { "regular" })[#desc]))
      y -= row-h
    }
  }),
  caption: [타임라인 — 종전(0년 4월 7일)을 기준으로 한 상대 연표. *간격은 사건 순서를 나타낼 뿐 햇수에 비례하지 않는다* — 각 항목의 연차 표기만이 정확하다. `proposals/P37` 확정안(`P49`·`P50`에서 수정). 원전 v2.4 amend — 하인리히가 붙잡힌 날과 죽은 날을 −1년에서 −8개월 · −7개월 언저리로 옮겼다(그가 프란의 임신을 생전에 알았다 — 제19.5화; 수태는 종전 9개월 전 언저리), 발굴도 함께.],
  supplement: none,
  numbering: none,
)
