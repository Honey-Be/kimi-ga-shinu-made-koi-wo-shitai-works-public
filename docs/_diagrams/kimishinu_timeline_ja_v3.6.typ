#let split = 35  // 첫 쪽의 행 수

#let era_label = (
  "親": "両親の時代",
  "娘": "娘の時代",
  "承諾": "承諾した人の時代",
  "終戦": "終戦",
  "以後": "終戦後",
  "下限": "時点を下限だけで定めた番外編 ― 軸に挟まない",
)

// v3.6 — 두 쪽(캔버스 둘). 「下限」는 축에 끼우지 않는 행(빈 점 · 왼쪽 칸은 하한).
#let tl(evs, cont: false) = canvas(length: 1cm, {
  import draw: *
  let row-h = 0.47  // v3.6 — 두 쪽으로 나누며 0.47로 되돌렸다(v3.5 — 0.52에서 0.47: 캡션이 쪽 아래로 잘렸다)
  let gap = 0.38
  let x-spine = 4.6
  let x-year-r = 4.3
  let x-text-l = 5.0
  let x-text-w = 13.2
  let ys = ()
  let y = 0.0
  let prev = none
  for ev in evs {
    if ev.at(2) != prev and prev != none { y -= gap }
    ys.push(y)
    y -= row-h
    prev = ev.at(2)
  }
  let axis = range(evs.len()).filter(i => evs.at(i).at(2) != "下限")
  if axis.len() > 0 {
    line((x-spine, 0.3), (x-spine, ys.at(axis.last()) - 0.1), stroke: (paint: gray, thickness: 1pt))
  }
  let prev = none
  for (i, ev) in evs.enumerate() {
    let (yr, desc, era) = ev
    let y = ys.at(i)
    if era != prev {
      let lbl = era_label.at(era)
      if cont and prev == none and era == "以後" { lbl = "終戦後(続き)" }
      content((x-text-l, y + row-h * 0.95), text(size: 8.5pt, fill: gray.darken(35%), weight: "bold")[#lbl])
      prev = era
    }
    let is-zero = era == "終戦"
    if era == "下限" {
      circle((x-spine, y), radius: 0.05, fill: white, stroke: 0.6pt + gray.darken(10%))
    } else {
      circle((x-spine, y), radius: if is-zero { 0.09 } else { 0.045 }, fill: if is-zero { black } else { gray.darken(10%) }, stroke: none)
    }
    content((x-year-r, y), anchor: "east",
      text(size: 8pt, weight: if is-zero { "bold" } else { "regular" })[#yr])
    content((x-text-l, y), anchor: "west",
      box(width: x-text-w * 1cm, text(size: 7.6pt, weight: if is-zero { "bold" } else { "regular" })[#desc]))
  }
})

