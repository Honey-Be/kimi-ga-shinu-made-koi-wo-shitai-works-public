#let split = 35  // 첫 쪽의 행 수

#let era_label = (
  "부모": "부모의 시대",
  "딸": "딸의 시대",
  "승낙": "승낙한 사람의 시대",
  "종전": "종전",
  "이후": "종전 이후",
